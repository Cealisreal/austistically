<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Add Photos/Videos</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials/nav') %>
  <h1>Add Photos/Videos</h1>
  <p>Add new photos or videos to the gallery.</p>
  <p id="status" class="error" hidden></p>
  <form id="addForm" class="form-page">
    <input type="file" name="media" accept="image/*,video/*" id="mediaInput" required>
    <div id="preview" class="preview"></div>
    <input type="text" name="title" placeholder="Title (optional)">
    <input type="text" name="description" placeholder="Description (optional)">
    <button type="submit">Upload</button>
  </form>
  <script type="module">
    import { upload } from 'https://esm.sh/@vercel/blob@2.6.1/client';

    const mediaInput = document.getElementById('mediaInput');
    const preview = document.getElementById('preview');
    const form = document.getElementById('addForm');
    const status = document.getElementById('status');

    mediaInput.addEventListener('change', function () {
      preview.innerHTML = '';
      const file = mediaInput.files[0];
      if (!file) {
        return;
      }
      const url = URL.createObjectURL(file);
      let el;
      if (file.type.indexOf('video/') === 0) {
        el = document.createElement('video');
        el.controls = true;
      } else {
        el = document.createElement('img');
      }
      el.src = url;
      preview.appendChild(el);
    });

    form.addEventListener('submit', async function (event) {
      event.preventDefault();
      const file = mediaInput.files[0];
      if (!file) {
        return;
      }
      const submitButton = form.querySelector('button[type="submit"]');
      submitButton.disabled = true;
      status.hidden = true;

      try {
        const safeName = file.name.replace(/[^a-zA-Z0-9.\-_]/g, '_');
        const pathname = 'media/' + Date.now() + '-' + safeName;

        const blob = await upload(pathname, file, {
          access: 'public',
          handleUploadUrl: '/api/media-upload-token',
          contentType: file.type,
          multipart: true
        });

        // The gallery index is a shared file everyone's uploads write to, so
        // two people saving at the exact same moment can occasionally
        // collide and get a 500 back even though the server already retried
        // internally. Retrying here a couple of times smooths over that
        // rare case instead of showing the user an error for it.
        let response;
        let lastError;
        for (let attempt = 0; attempt < 3; attempt++) {
          if (attempt > 0) {
            await new Promise(function (resolve) { setTimeout(resolve, 300 * attempt); });
          }
          response = await fetch('/api/media', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              url: blob.url,
              contentType: file.type,
              title: form.title.value.trim(),
              description: form.description.value.trim()
            })
          });
          if (response.ok) {
            lastError = null;
            break;
          }
          const data = await response.json().catch(function () { return {}; });
          lastError = data.error || 'Could not save the upload.';
        }

        if (lastError) {
          throw new Error(lastError);
        }

        window.location.href = '/';
      } catch (err) {
        status.textContent = err.message || 'Upload failed. Please try again.';
        status.hidden = false;
        submitButton.disabled = false;
      }
    });
  </script>
</body>
</html>
