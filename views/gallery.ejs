<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Gallery</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials/nav') %>
  <h1>Gallery</h1>
  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>
  <% if (items.length === 0) { %>
    <p class="empty">No photos or videos yet. <a href="/add">Add the first one!</a></p>
  <% } else { %>
    <div class="grid">
      <% items.forEach(function (item) { %>
        <div class="card">
          <% if (item.type === 'image') { %>
            <img src="<%= item.url %>" alt="<%= item.title %>">
          <% } else { %>
            <video src="<%= item.url %>" controls preload="metadata"></video>
          <% } %>
          <% if (item.title || item.description || item.addedBy) { %>
            <div class="caption">
              <% if (item.title) { %><p class="title"><%= item.title %></p><% } %>
              <% if (item.description) { %><p class="description"><%= item.description %></p><% } %>
              <% if (item.addedBy) { %>
                <p class="added-by">
                  <% if (item.addedByPicture) { %><img class="avatar avatar-small" src="<%= item.addedByPicture %>" alt="<%= item.addedBy %>"><% } %>
                  Added by <%= item.addedBy %>
                </p>
              <% } %>
            </div>
          <% } %>
          <% if (item.canManage) { %>
            <div class="card-actions">
              <a href="/edit/<%= item.id %>">Edit</a>
              <form action="/delete/<%= item.id %>" method="POST" onsubmit="return confirm('Delete this item? This cannot be undone.');">
                <button type="submit" class="delete-btn">Delete</button>
              </form>
            </div>
          <% } %>
        </div>
      <% }); %>
    </div>
  <% } %>
</body>
</html>
